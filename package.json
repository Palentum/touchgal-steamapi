{
  "name": "touchgal-steamapi",
  "version": "1.0.0",
  "private": true,
  "description": "A lightweight Steam Store scraping service with steam-session based cookie refresh.",
  "main": "server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node server.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:restart": "pm2 restart touchgal-steamapi",
    "pm2:reload": "pm2 reload ecosystem.config.js --only touchgal-steamapi",
    "pm2:stop": "pm2 stop touchgal-steamapi",
    "pm2:delete": "pm2 delete touchgal-steamapi",
    "pm2:logs": "pm2 logs touchgal-steamapi",
    "pm2:save": "pm2 save"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "axios-cookiejar-support": "^6.0.5",
    "cheerio": "^1.2.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "http-cookie-agent": "^7.0.4",
    "socks-proxy-agent": "^10.1.0",
    "steam-session": "^1.9.4",
    "tough-cookie": "^6.0.1"
  },
  "devDependencies": {
    "pm2": "^7.0.1"
  },
  "overrides": {
    "js-yaml": "^4.1.2",
    "ws": "^8.21.0"
  }
}
